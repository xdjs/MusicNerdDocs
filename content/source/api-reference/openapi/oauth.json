{
  "openapi": "3.1.0",
  "info": {
    "title": "Music Nerd API: OAuth",
    "version": "1.0.0",
    "description": "How agents connect to the MCP server with OAuth: the discovery documents an MCP client reads, and the member's list of connected agents."
  },
  "servers": [
    {
      "url": "https://api.musicnerd.net",
      "description": "Production"
    },
    {
      "url": "https://musicnerd-api-staging.vercel.app",
      "description": "Staging (staging database)"
    }
  ],
  "paths": {
    "/.well-known/oauth-protected-resource/mcp": {
      "get": {
        "summary": "MCP resource metadata",
        "operationId": "getMcpResourceMetadata",
        "security": [],
        "description": "The OAuth protected-resource metadata for `/mcp` (RFC 9728). An MCP client reads it after a 401 from `/mcp` to find the authorization server.",
        "responses": {
          "200": {
            "description": "The metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceMetadata"
                },
                "example": {
                  "resource": "https://api.musicnerd.net/mcp",
                  "authorization_servers": [
                    "https://api.musicnerd.net/api/oauth"
                  ],
                  "scopes_supported": [
                    "mcp:tools"
                  ],
                  "bearer_methods_supported": [
                    "header"
                  ],
                  "resource_name": "Music Nerd"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/oauth-authorization-server/api/oauth": {
      "get": {
        "summary": "Authorization server metadata",
        "operationId": "getAuthorizationServerMetadata",
        "security": [],
        "description": "The OAuth authorization server metadata (RFC 8414) for `https://api.musicnerd.net/api/oauth`. Clients register, then use the authorization code flow with PKCE; access tokens last five minutes and refresh tokens rotate on every use. Signing in opens a Music Nerd page where the user approves the agent.",
        "responses": {
          "200": {
            "description": "The metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationServerMetadata"
                },
                "example": {
                  "issuer": "https://api.musicnerd.net/api/oauth",
                  "authorization_endpoint": "https://api.musicnerd.net/api/oauth/auth",
                  "token_endpoint": "https://api.musicnerd.net/api/oauth/token",
                  "registration_endpoint": "https://api.musicnerd.net/api/oauth/reg",
                  "scopes_supported": [
                    "mcp:tools"
                  ],
                  "response_types_supported": [
                    "code"
                  ],
                  "grant_types_supported": [
                    "authorization_code",
                    "refresh_token"
                  ],
                  "code_challenge_methods_supported": [
                    "S256"
                  ],
                  "token_endpoint_auth_methods_supported": [
                    "none"
                  ],
                  "authorization_response_iss_parameter_supported": true
                }
              }
            }
          }
        }
      }
    },
    "/api/oauth/reg": {
      "post": {
        "summary": "Register a client",
        "operationId": "registerOAuthClient",
        "security": [],
        "description": "Registers an MCP client (RFC 7591) and returns its `client_id`. Redirect URIs must use HTTPS, or HTTP on `localhost` or `127.0.0.1`. Clients get no secret and prove themselves with PKCE instead.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "redirect_uris"
                ],
                "properties": {
                  "client_name": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "The agent's name, shown when the user approves it. Not verified."
                  },
                  "redirect_uris": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "format": "uri"
                    },
                    "description": "Where to send the user back after approving."
                  },
                  "grant_types": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Ignored; the client always gets `authorization_code` and `refresh_token`."
                  },
                  "token_endpoint_auth_method": {
                    "type": "string",
                    "description": "Ignored; always `none`."
                  }
                }
              },
              "example": {
                "client_name": "Claude",
                "redirect_uris": [
                  "http://127.0.0.1:33418/callback"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientRegistration"
                },
                "example": {
                  "client_id": "2f6c1d0e-8a4b-4c47-9a51-3e0f7b9d2c18",
                  "client_name": "Claude",
                  "redirect_uris": [
                    "http://127.0.0.1:33418/callback"
                  ],
                  "grant_types": [
                    "authorization_code",
                    "refresh_token"
                  ],
                  "response_types": [
                    "code"
                  ],
                  "token_endpoint_auth_method": "none"
                }
              }
            }
          },
          "400": {
            "description": "A redirect URI is missing or not allowed (`invalid_redirect_uri`), or the body is invalid (`invalid_client_metadata`). Errors use the standard OAuth shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "error": "invalid_redirect_uri",
                  "error_description": "Redirect URIs must use https, or http on localhost"
                }
              }
            }
          }
        }
      }
    },
    "/api/oauth/auth": {
      "get": {
        "summary": "Start authorization",
        "operationId": "authorizeOAuthClient",
        "security": [],
        "description": "Where an MCP client sends the user's browser to connect. A valid request redirects to the Music Nerd page where the user signs in and approves the agent; an invalid one redirects back to the client with `error` and `state`.",
        "parameters": [
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "code"
              ]
            },
            "example": "code",
            "description": "Always `code`."
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "2f6c1d0e-8a4b-4c47-9a51-3e0f7b9d2c18",
            "description": "The `client_id` from registration."
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "http://127.0.0.1:33418/callback",
            "description": "One of the client's registered redirect URIs, exactly."
          },
          {
            "name": "code_challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM",
            "description": "The PKCE challenge: base64url SHA-256 of the code verifier."
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "S256"
              ]
            },
            "example": "S256",
            "description": "Always `S256`."
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "af0ifjsldkj",
            "description": "Returned unchanged to the client."
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "mcp:tools",
            "description": "`mcp:tools`, the only scope. Optional."
          },
          {
            "name": "resource",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "https://api.musicnerd.net/mcp",
            "description": "`https://api.musicnerd.net/mcp`, if sent."
          }
        ],
        "responses": {
          "302": {
            "description": "To the Music Nerd sign-in page with the same query, or back to `redirect_uri` with `error` and `state` when the request is invalid.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "The sign-in page, or the client's redirect URI with the error."
              }
            }
          },
          "400": {
            "description": "Unknown `client_id`, or a `redirect_uri` the client didn't register. Nothing is redirected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "error": "invalid_request",
                  "error_description": "Unknown client or redirect_uri"
                }
              }
            }
          }
        }
      }
    },
    "/api/oauth/token": {
      "post": {
        "summary": "Get a token",
        "operationId": "getOAuthToken",
        "security": [],
        "description": "Swaps an authorization code or a refresh token for a new access token and refresh token. Access tokens last five minutes. Refresh tokens rotate on every use and last until the user disconnects the agent; reusing one that was already used disconnects the agent, if it is the last one used or was used in the past 30 days.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type",
                  "client_id"
                ],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "authorization_code",
                      "refresh_token"
                    ]
                  },
                  "client_id": {
                    "type": "string",
                    "description": "The `client_id` from registration."
                  },
                  "code": {
                    "type": "string",
                    "description": "For `authorization_code`: the code from the redirect. Single use, valid for 60 seconds."
                  },
                  "code_verifier": {
                    "type": "string",
                    "description": "For `authorization_code`: the PKCE verifier behind `code_challenge`."
                  },
                  "redirect_uri": {
                    "type": "string",
                    "description": "For `authorization_code`: the same `redirect_uri` as the authorization request."
                  },
                  "refresh_token": {
                    "type": "string",
                    "description": "For `refresh_token`: the latest refresh token. Single use."
                  }
                }
              },
              "example": {
                "grant_type": "authorization_code",
                "client_id": "2f6c1d0e-8a4b-4c47-9a51-3e0f7b9d2c18",
                "code": "mn_code_EXAMPLE",
                "code_verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk",
                "redirect_uri": "http://127.0.0.1:33418/callback"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A new access token and refresh token, with `Cache-Control: no-store`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                },
                "example": {
                  "access_token": "mn_at_EXAMPLE",
                  "token_type": "Bearer",
                  "expires_in": 300,
                  "refresh_token": "mn_rt_EXAMPLE",
                  "scope": "mcp:tools"
                }
              }
            }
          },
          "400": {
            "description": "The code or refresh token is invalid, expired or already used, or the verifier, client or redirect URI doesn't match (`invalid_grant`); or the request is malformed (`invalid_request`, `unsupported_grant_type`). Errors use the standard OAuth shape.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                },
                "example": {
                  "error": "invalid_grant",
                  "error_description": "The code is invalid, expired or already used"
                }
              }
            }
          }
        }
      }
    },
    "/api/oauth/consent": {
      "get": {
        "summary": "Read a connection request",
        "operationId": "getOAuthConsent",
        "security": [],
        "description": "Checks an authorization request and says which agent is asking, for the Music Nerd sign-in page to show before the user approves. Takes the same query as Start authorization.",
        "parameters": [
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "code"
              ]
            },
            "example": "code",
            "description": "Always `code`."
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "2f6c1d0e-8a4b-4c47-9a51-3e0f7b9d2c18",
            "description": "The `client_id` from registration."
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "http://127.0.0.1:33418/callback",
            "description": "One of the client's registered redirect URIs, exactly."
          },
          {
            "name": "code_challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM",
            "description": "The PKCE challenge: base64url SHA-256 of the code verifier."
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "S256"
              ]
            },
            "example": "S256",
            "description": "Always `S256`."
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "af0ifjsldkj",
            "description": "Returned unchanged to the client."
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "mcp:tools",
            "description": "`mcp:tools`, the only scope. Optional."
          },
          {
            "name": "resource",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "https://api.musicnerd.net/mcp",
            "description": "`https://api.musicnerd.net/mcp`, if sent."
          }
        ],
        "responses": {
          "200": {
            "description": "The request is valid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "agent",
                    "redirectHost"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "agent": {
                      "type": "string",
                      "description": "The name the agent gave when it registered. Not verified."
                    },
                    "redirectHost": {
                      "type": "string",
                      "description": "The host the user is sent back to, like `127.0.0.1:33418`."
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "agent": "Claude",
                  "redirectHost": "127.0.0.1:33418"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid: unknown client, unregistered redirect or missing PKCE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Invalid authorization request"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "summary": "Approve or deny an agent",
        "operationId": "postOAuthConsent",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "Records the signed-in user's decision on an authorization request and returns where to send the browser. Approving connects the agent and adds a single-use code, valid for 60 seconds; denying adds `error=access_denied`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "The query of the authorization request, plus the decision.",
                "required": [
                  "response_type",
                  "client_id",
                  "redirect_uri",
                  "code_challenge",
                  "code_challenge_method",
                  "decision"
                ],
                "properties": {
                  "response_type": {
                    "type": "string",
                    "enum": [
                      "code"
                    ]
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "redirect_uri": {
                    "type": "string"
                  },
                  "code_challenge": {
                    "type": "string"
                  },
                  "code_challenge_method": {
                    "type": "string",
                    "enum": [
                      "S256"
                    ]
                  },
                  "state": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  },
                  "resource": {
                    "type": "string"
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approve",
                      "deny"
                    ]
                  }
                }
              },
              "example": {
                "response_type": "code",
                "client_id": "2f6c1d0e-8a4b-4c47-9a51-3e0f7b9d2c18",
                "redirect_uri": "http://127.0.0.1:33418/callback",
                "code_challenge": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM",
                "code_challenge_method": "S256",
                "state": "af0ifjsldkj",
                "decision": "approve"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Where to send the browser: the client's redirect URI with `code`, `state` and `iss`, or with `error=access_denied` and `state`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "redirectUrl"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "redirectUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "redirectUrl": "http://127.0.0.1:33418/callback?code=mn_code_EXAMPLE&state=af0ifjsldkj&iss=https%3A%2F%2Fapi.musicnerd.net%2Fapi%2Foauth"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid: unknown client, unregistered redirect, missing PKCE or no decision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Invalid authorization request"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/oauth/connections": {
      "get": {
        "summary": "List connected agents",
        "operationId": "listOAuthConnections",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "The agents the signed-in user has connected to the MCP server, newest first. A connection lasts until the user disconnects it, and its refresh tokens rotate on every use. Reusing a refresh token that was already used disconnects the agent, if it is the last one used or was used in the past 30 days.",
        "responses": {
          "200": {
            "description": "The connections.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "connections"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "connections": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Connection"
                      }
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "connections": [
                    {
                      "id": "conn_7f3a2c",
                      "agent": "Claude",
                      "scopes": [
                        "mcp:tools"
                      ],
                      "connectedAt": "2026-11-20T18:02:11.000Z",
                      "lastUsedAt": "2026-11-20T19:40:05.000Z"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/oauth/connections/{id}": {
      "delete": {
        "summary": "Disconnect an agent",
        "operationId": "deleteOAuthConnection",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "Disconnects one of the signed-in user's agents; its tokens stop working at once. Answers 200 when the connection is already gone or isn't the user's.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "conn_7f3a2c",
            "description": "The connection's ID, from the list."
          }
        ],
        "responses": {
          "200": {
            "description": "Disconnected.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "privyBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Access token",
        "description": "A Privy access token for a signed-in Music Nerd user, as musicnerd.net holds it."
      }
    },
    "responses": {
      "NotSignedIn": {
        "description": "No token, or an invalid or expired one.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "error": "Not signed in"
            }
          }
        }
      },
      "InternalError": {
        "description": "The database could not be read or written.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "error": "Internal server error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Connection": {
        "type": "object",
        "required": [
          "id",
          "agent",
          "scopes",
          "connectedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The connection's ID."
          },
          "agent": {
            "type": "string",
            "description": "The name the agent gave when it registered, like `Claude`. Not verified."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What the member approved, like `mcp:tools`."
          },
          "connectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the agent last refreshed its token, or null."
          }
        }
      },
      "ResourceMetadata": {
        "type": "object",
        "required": [
          "resource",
          "authorization_servers"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "format": "uri"
          },
          "authorization_servers": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bearer_methods_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resource_name": {
            "type": "string"
          }
        }
      },
      "AuthorizationServerMetadata": {
        "type": "object",
        "required": [
          "issuer",
          "authorization_endpoint",
          "token_endpoint",
          "response_types_supported"
        ],
        "additionalProperties": true,
        "properties": {
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "authorization_endpoint": {
            "type": "string",
            "format": "uri"
          },
          "token_endpoint": {
            "type": "string",
            "format": "uri"
          },
          "registration_endpoint": {
            "type": "string",
            "format": "uri"
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "response_types_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grant_types_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code_challenge_methods_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "token_endpoint_auth_methods_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authorization_response_iss_parameter_supported": {
            "type": "boolean"
          }
        }
      },
      "OAuthError": {
        "type": "object",
        "description": "The standard OAuth error shape (RFC 6749), used by registration, authorization and the token endpoint instead of `{status, error}`.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "An OAuth error code, like `invalid_grant`."
          },
          "error_description": {
            "type": "string"
          }
        }
      },
      "ClientRegistration": {
        "type": "object",
        "required": [
          "client_id",
          "redirect_uris",
          "grant_types",
          "response_types",
          "token_endpoint_auth_method"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "redirect_uris": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "grant_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "response_types": {
            "type": "array",
            "items": {
