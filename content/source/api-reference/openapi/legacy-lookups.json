  "paths": {
    "/api/findArtistBySpotifyID": {
      "post": {
        "summary": "Find an artist by Spotify ID",
        "description": "Finds the artist whose `spotify` column equals `spotifyID` exactly (case-sensitive) and returns the whole artist row. If several rows match, the first is returned. No credentials.\n\nKept for Sleeve Note: same path, body and response shape as the legacy `api.musicnerd.xyz` route, so it does not follow this API's `{ status }` convention. Two deliberate differences from the legacy route: a database failure returns 500 (it returned 404), and a body that is not JSON returns 400 (it returned an unhandled 500).",
        "operationId": "findArtistBySpotifyID",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "spotifyID"
                ],
                "properties": {
                  "spotifyID": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "spotifyID": "4Z8W4fKeB5YxbusRsdQVPb"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The matching artist.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "result"
                  ],
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/LegacyArtist"
                    }
                  }
                },
                "example": {
                  "result": {
                    "id": "6cb3d81a-0000-4000-8000-000000000000",
                    "legacyId": null,
                    "bandcamp": null,
                    "facebook": null,
                    "x": "exampleartist",
                    "soundcloud": null,
                    "notes": null,
                    "patreon": null,
                    "name": "Example Artist",
                    "instagram": "exampleartist",
                    "youtube": null,
                    "youtubechannel": null,
                    "lcname": "example artist",
                    "soundcloudId": null,
                    "spotify": "4Z8W4fKeB5YxbusRsdQVPb",
                    "twitch": null,
                    "imdb": null,
                    "musicbrainz": null,
                    "wikidata": null,
                    "mixcloud": null,
                    "facebookId": null,
                    "discogs": null,
                    "tiktok": null,
                    "tiktokId": null,
                    "jaxsta": null,
                    "famousbirthdays": null,
                    "songexploder": null,
                    "colorsxstudios": null,
                    "bandsintown": null,
                    "linktree": null,
                    "onlyfans": null,
                    "wikipedia": null,
                    "audius": null,
                    "zora": null,
                    "catalog": null,
                    "opensea": null,
                    "foundation": null,
                    "lastfm": null,
                    "linkedin": null,
                    "soundxyz": null,
                    "mirror": null,
                    "glassnode": null,
                    "collectsNfTs": null,
                    "spotifyusername": null,
                    "bandcampfan": null,
                    "tellie": null,
                    "wallets": null,
                    "ens": null,
                    "lens": null,
                    "addedBy": null,
                    "cameo": null,
                    "farcaster": null,
                    "createdAt": "2024-05-01 12:00:00.123+00",
                    "updatedAt": "2026-10-01 12:00:00.123+00",
                    "supercollector": null,
                    "bio": null,
                    "customImage": null,
                    "headerImagePosition": null,
                    "linkOrder": null,
                    "webmapdata": null,
                    "nodePfp": null,
                    "deezer": null,
                    "subvert": null,
                    "bluesky": null,
                    "inprocess": null
                  }
                }
              }
            }
          },
          "400": {
            "description": "`spotifyID` is missing or not a string, or the body is not JSON.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "Missing or invalid required parameters: spotifyID"
              }
            }
          },
          "404": {
            "description": "No artist has that value.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "The artist you're searching for is not found"
