  "info": {
    "title": "Music Nerd API: legacy lookups",
    "version": "1.0.0",
    "description": "Artist lookups copied from MusicNerdWeb for Sleeve Note. Once these are in production, `api.musicnerd.xyz` will point at this API (xdjs/MusicNerdWeb#1480)."
