    "/api/findTwitterHandle": {
      "post": {
        "summary": "Find an artist's X handle",
        "description": "Returns the X (Twitter) handle of an artist found by wallet, ENS name or artist name. No credentials.\n\nWhen `ethAddress` is sent, it is used and `name` is ignored. A `0x` address of 40 hex characters is matched against the artist's wallets first, then against `ens`; any other value is matched against `ens` only. These matches are exact.\n\nOtherwise `name` runs a fuzzy search over artist names, substring matches first and then trigram similarity of at least 0.3, and the best-ranked artist is used.\n\n`result` is the artist's `x` column, which may be `null`. When `name` matches no artist, the response is **200 `{}`** (no `result`), not 404, as in the legacy route.\n\nKept for Sleeve Note: same path, body and response shape as the legacy `api.musicnerd.xyz` route, so it does not follow this API's `{ status }` convention. Two deliberate differences from the legacy route: a database failure returns 500 (it returned 404), and a body that is not JSON returns 400 (it returned an unhandled 500).",
        "operationId": "findTwitterHandle",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "ethAddress": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "ethAddress": "0x0000000000000000000000000000000000000001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The artist's X handle, or `{}` when a name search matches nothing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "examples": {
                  "found": {
                    "value": {
                      "result": "exampleartist"
                    }
                  },
                  "noNameMatch": {
                    "value": {}
                  }
                }
              }
            }
          },
          "400": {
            "description": "Neither `name` nor `ethAddress` is a non-empty string, or the body is not JSON.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "Missing or invalid required parameters: name or ethAddress"
              }
            }
          },
          "404": {
            "description": "`ethAddress` matches no wallet or ENS name.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "The artist you're searching for is not found"
              }
            }
          },
          "500": {
            "description": "The database could not be read.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "Something went wrong on our end"
              }
            }
          }
        }
      }
    }
