{
  "openapi": "3.1.0",
  "info": {
    "title": "Music Nerd interview response revisions \u2014 draft",
    "version": "1.0.0",
    "description": "Draft, unreleased API contract for private artist interview review. Separate from starting or generating interviews."
  },
  "servers": [
    {
      "url": "https://musicnerd-api.vercel.app",
      "description": "Production API; these new routes are not released yet."
    }
  ],
  "paths": {
    "/api/artist/{id}/interview/responses": {
      "get": {
        "operationId": "listInterviewResponses",
        "summary": "List saved interview responses",
        "description": "Draft implementation contract; not yet released. Reads answered questions only. No collection or generation. Preserves question, sitting and offer time. History begins with retained records, not reconstructed earlier edits. Reads fail explicitly above 2,000 records or 1,000,000 stored characters; exact response text is never silently truncated. Each response permits at most 50,000 answer characters and 10,000 question characters. Edits are limited to 2,000 answer characters. Earlier revisions use the same bounded history budget.",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Artist ID in the selected environment."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque continuation returned by the same operation. Changed data can invalidate it."
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result; Cache-Control: private, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID, unexpected field or invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Privy access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current approved claimant or administrator required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Response or requested revision unavailable for this artist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Response changed or pagination is stale. Reload before retrying.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request or stored record exceeds the supported size; nothing is silently truncated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable; this is not an empty history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/artist/{id}/interview/responses/{answerId}": {
      "get": {
        "operationId": "readInterviewResponse",
        "summary": "Read an exact interview response",
        "description": "Draft implementation contract; not yet released. Without revision, returns current wording. A revision resolves the exact retained response and reports whether it is current. Older versions are historical evidence, not the current artist answer.",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Artist ID in the selected environment."
          },
          {
            "name": "answerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "example": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result; Cache-Control: private, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRead"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID, unexpected field or invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Privy access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current approved claimant or administrator required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Response or requested revision unavailable for this artist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Response changed or pagination is stale. Reload before retrying.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request or stored record exceeds the supported size; nothing is silently truncated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable; this is not an empty history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "reviseInterviewResponse",
        "summary": "Revise a saved interview response",
        "description": "Draft implementation contract; not yet released. The authenticated current claimant/admin edits an answered question. expectedRevision rejects stale overwrites. Exact question, sitting and offeredAt are immutable. Earlier wording is retained, current knowledge history reads the new answer, and the edit is audited. A byte-identical answer is a no-op. note describes the edit and is not artist evidence. Edits do not automatically publish a new bio. No blank/delete/skip conversion. The edit, version archive, activity attribution and Lore refresh queue entry commit atomically; a queue failure rolls the edit back. Older generated Lore may remain visible until the queued refresh completes. Request bodies are bounded to 20,000 bytes.",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Artist ID in the selected environment."
          },
          {
            "name": "answerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result; Cache-Control: private, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRead"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID, unexpected field or invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Privy access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current approved claimant or administrator required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Response or requested revision unavailable for this artist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Response changed or pagination is stale. Reload before retrying.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request or stored record exceeds the supported size; nothing is silently truncated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable; this is not an empty history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevisionInput"
              }
            }
          }
        }
      }
    },
    "/api/artist/{id}/interview/responses/{answerId}/versions": {
      "get": {
        "operationId": "listInterviewResponseVersions",
        "summary": "List response versions",
        "description": "Draft implementation contract; not yet released. Current and retained earlier response versions, newest first. Current ownership is rechecked. Every entry has exact original wording and a stable revision; no reconstruction of unretained past edits.",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Artist ID in the selected environment."
          },
          {
            "name": "answerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque continuation returned by the same operation. Changed data can invalidate it."
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result; Cache-Control: private, no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseVersions"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID, unexpected field or invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Privy access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current approved claimant or administrator required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Response or requested revision unavailable for this artist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Response changed or pagination is stale. Reload before retrying.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request or stored record exceeds the supported size; nothing is silently truncated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable; this is not an empty history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "privyBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Privy access token"
      }
    },
    "schemas": {
      "Response": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "questionKey": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "sitting": {
            "type": [
              "integer",
              "null"
            ]
          },
          "offeredAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "answerUpdatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "example": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          }
        },
        "required": [
          "id",
          "questionKey",
          "question",
          "answer",
          "source",
          "sitting",
          "offeredAt",
          "answerUpdatedAt",
          "revision"
        ]
      },
      "Version": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "response": {
            "$ref": "#/components/schemas/Response"
          },
          "savedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "isCurrent": {
            "type": "boolean"
          }
        },
        "required": [
          "response",
          "savedAt",
          "note",
          "isCurrent"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "error",
          "code"
        ]
      },
      "ResponseList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "responses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Response"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "responses",
          "nextCursor"
        ]
      },
      "ResponseRead": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "response": {
            "$ref": "#/components/schemas/Response"
          },
          "isCurrent": {
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "response",
          "isCurrent"
        ]
      },
      "ResponseVersions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Version"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "versions",
          "nextCursor"
        ]
      },
      "RevisionInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "example": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "note": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "expectedRevision",
          "answer"
        ]
      }
    }
  }
}
