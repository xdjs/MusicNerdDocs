{
  "openapi": "3.1.0",
  "info": {
    "title": "Music Nerd API: admin",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://musicnerd-api.vercel.app",
      "description": "Production"
    },
    {
      "url": "https://musicnerd-api-staging.vercel.app",
      "description": "Staging (staging database)"
    }
  ],
  "paths": {
    "/api/admin/artist-data": {
      "get": {
        "summary": "Artist data",
        "operationId": "getArtistData",
        "security": [
          {
            "adminBearer": []
          }
        ],
        "description": "Artist data coverage: how many artists exist and have a Spotify ID, platform-ID coverage with today's count, link coverage per platform (today's count comes from MCP writes only), the distribution of how many tracked fields each artist has, and enrichment readiness.",
        "responses": {
          "200": {
            "description": "The catalog summary; a repeat call within 30 seconds may return the same numbers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtistDataSummary"
                },
                "example": {
                  "status": "ok",
                  "totalArtists": 41971,
                  "totalWithSpotify": 38403,
                  "platformIdCoverage": [
                    {
                      "platform": "deezer",
                      "count": 1210,
                      "percentage": 3.15,
                      "todayCount": 11
                    }
                  ],
                  "artistLinkCoverage": [
                    {
                      "column": "instagram",
                      "category": "social",
                      "count": 29010,
                      "percentage": 69.12,
                      "todayCount": 0
                    },
                    {
                      "column": "bio",
                      "category": "content",
                      "count": 4120,
                      "percentage": 9.82,
                      "todayCount": 0
                    }
                  ],
                  "completenessDistribution": [
                    {
                      "bucket": "0-1",
                      "count": 3783,
                      "percentage": 9.01
                    },
                    {
                      "bucket": "2-3",
                      "count": 12050,
                      "percentage": 28.71
                    }
                  ],
                  "medianFields": 5,
                  "averageFields": 5.2,
                  "enrichmentReadiness": {
                    "hasWikidata": 41,
                    "hasSpotifyNoWikidata": 38362,
                    "noSpotify": 3568
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "403": {
            "$ref": "#/components/responses/NotAdmin"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/admin/bio-corrections/{id}": {
      "patch": {
        "summary": "Review an About correction report",
        "operationId": "reviewBioCorrection",
        "security": [
          {
            "adminBearer": []
          }
        ],
        "description": "Marks a pending About correction report `resolved` or `dismissed`, recording who reviewed it and when. A report that was already reviewed is not changed. To fix the About itself, use [Save the About for a report](/api-reference/admin/save-correction-about), which resolves the report as part of the save.",
        "parameters": [
          {
            "$ref": "#/components/parameters/reportId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "resolved",
                      "dismissed"
                    ],
                    "description": "The review outcome."
                  }
                }
              },
              "example": {
                "status": "dismissed"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The report is reviewed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                },
                "example": {
                  "status": "ok",
                  "success": true
                }
              }
            }
          },
          "400": {
            "description": "`id` isn't a UUID, or `status` isn't `resolved` or `dismissed`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "id": {
                    "value": {
                      "status": "error",
                      "error": "Invalid report ID"
                    }
                  },
                  "status": {
                    "value": {
                      "status": "error",
                      "error": "Invalid review status"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "403": {
            "$ref": "#/components/responses/NotAdmin"
          },
          "409": {
            "description": "The report was already reviewed, or there is no report with that ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Report was already reviewed or does not exist"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/admin/bio-corrections/{id}/about": {
      "get": {
        "summary": "Read the About for a report",
        "operationId": "getCorrectionAbout",
        "security": [
          {
            "adminBearer": []
          }
        ],
        "description": "The About currently published for the artist a pending correction report is about, with a `revision` hash to send back on save. For a claimed artist that is their own About; for an unclaimed one, the public directory About.",
        "parameters": [
          {
            "$ref": "#/components/parameters/reportId"
          }
        ],
        "responses": {
          "200": {
            "description": "The published About and its revision.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorrectionAbout"
                },
                "example": {
                  "status": "ok",
                  "bio": "Bio Ritmo is a 10-piece salsa band from Richmond, Virginia.",
                  "revision": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidReportId"
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "403": {
            "$ref": "#/components/responses/NotAdmin"
          },
          "409": {
            "description": "The report was already reviewed or no longer exists, the About is pinned (unpin it on the artist profile first), or the published About is no longer available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "reviewed": {
                    "value": {
                      "status": "error",
                      "error": "This report has already been reviewed or no longer exists."
                    }
                  },
                  "pinned": {
                    "value": {
                      "status": "error",
                      "error": "This About is pinned. Unpin it on the artist profile before editing."
                    }
                  },
                  "unavailable": {
                    "value": {
                      "status": "error",
                      "error": "The published About is no longer available. Review the artist profile before resolving this report."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The About could not be read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Could not load the current About. Try again."
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save the About for a report",
        "operationId": "saveCorrectionAbout",
        "security": [
          {
            "adminBearer": []
          }
        ],
        "description": "Replaces the artist's published About and resolves the report in one step, keeping the old text in the artist's bio history and recording an `about_edited` activity. `revision` must match what [Read the About for a report](/api-reference/admin/get-correction-about) returned; if the About or the artist's ownership changed since, nothing is saved and the response is 409.",
        "parameters": [
          {
            "$ref": "#/components/parameters/reportId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "bio",
                  "revision"
                ],
                "properties": {
                  "bio": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000,
                    "description": "The new About. Trimmed; up to 10,000 characters."
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "description": "The `revision` from the read."
                  }
                }
              },
              "example": {
                "bio": "Bio Ritmo is a 10-piece salsa orchestra from Richmond, Virginia, formed in 1991.",
                "revision": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The About is saved and the report resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                },
                "example": {
                  "status": "ok",
                  "success": true
                }
              }
            }
          },
          "400": {
            "description": "`id` isn't a UUID, or the body isn't a non-empty `bio` of up to 10,000 characters with a 64-hex-character `revision`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "id": {
                    "value": {
                      "status": "error",
                      "error": "Invalid report ID"
                    }
                  },
                  "body": {
                    "value": {
                      "status": "error",
                      "error": "Enter a valid About and reload the editor if needed."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "403": {
            "$ref": "#/components/responses/NotAdmin"
          },
          "409": {
            "description": "The save was refused: the revision no longer matches, the report was reviewed meanwhile, the About is pinned, or the published About is no longer available, or the new text isn't a real About. The draft is not saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "The About or artist ownership changed. Your draft is kept; cancel and reopen the editor to review the latest version."
                }
              }
            }
          },
          "500": {
            "description": "The save could not be confirmed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Could not confirm the save. Your draft is kept; refresh the queue before retrying."
                }
              }
            }
          }
        }
      }
    },
    "/api/pendingUGCCount": {
      "get": {
        "summary": "Pending UGC count",
        "operationId": "getPendingUgcCount",
        "security": [
          {
            "adminBearer": []
          },
          {}
        ],
        "description": "How many user-submitted links are waiting for admin review. A caller who is not signed in or not an admin gets `count: 0` rather than an error, and so does a database failure.",
        "responses": {
          "200": {
            "description": "The count; 0 for anyone who isn't an admin.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "count"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "examples": {
                  "admin": {
                    "summary": "An admin with three links to review",
                    "value": {
                      "status": "ok",
                      "count": 3
                    }
                  },
                  "other": {
                    "summary": "Not signed in, or not an admin",
                    "value": {
                      "status": "ok",
                      "count": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Access token",
        "description": "A Music Nerd admin's access token. Copy it at https://musicnerd.net/access after signing in. A signed-in user who is not an admin gets 403."
      }
    },
    "parameters": {
      "reportId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The correction report's ID (a UUID).",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "e7a5f235-4e66-40ba-9ff6-7276339fe34f"
      }
    },
    "responses": {
      "NotSignedIn": {
        "description": "No token, an invalid or expired token, or no Music Nerd user for it.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "error": "Not signed in"
            }
          }
        }
      },
      "NotAdmin": {
        "description": "The user is not an admin.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "error": "Forbidden"
            }
          }
        }
      },
      "InvalidReportId": {
        "description": "`id` isn't a UUID.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "error": "Invalid report ID"
            }
          }
        }
      },
      "InternalError": {
        "description": "The database could not be read or written.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "error": "Internal server error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Success": {
        "type": "object",
        "required": [
          "status",
          "success"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "ArtistDataSummary": {
        "type": "object",
        "required": [
          "status",
          "totalArtists",
          "totalWithSpotify",
          "platformIdCoverage",
          "artistLinkCoverage",
          "completenessDistribution",
          "medianFields",
          "averageFields",
          "enrichmentReadiness"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "totalArtists": {
            "type": "integer"
          },
          "totalWithSpotify": {
            "type": "integer",
            "description": "Artists with a non-empty `spotify`."
          },
          "platformIdCoverage": {
            "type": "array",
            "description": "From `artist_id_mappings`, most mapped first. Only platforms with at least one mapping appear.",
            "items": {
              "type": "object",
              "required": [
                "platform",
                "count",
                "percentage",
                "todayCount"
              ],
              "properties": {
                "platform": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "percentage": {
                  "type": "number",
                  "description": "Of `totalWithSpotify`, to two decimals."
                },
                "todayCount": {
                  "type": "integer"
                }
              }
            }
          },
          "artistLinkCoverage": {
            "type": "array",
            "description": "One row per tracked column, in a fixed order: instagram, bluesky, x, facebook, tiktok, youtube, youtubechannel, soundcloud, bandcamp, subvert, discogs, lastfm, musicbrainz, wikidata, imdb, wikipedia, bio, linkedin, farcaster, twitch, patreon. Spotify is left out because it is the denominator elsewhere.",
            "items": {
              "type": "object",
              "required": [
                "column",
                "category",
                "count",
                "percentage",
                "todayCount"
              ],
              "properties": {
                "column": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "social",
                    "listen",
                    "reference",
                    "content"
                  ]
                },
                "count": {
                  "type": "integer"
                },
                "percentage": {
                  "type": "number",
                  "description": "Of `totalArtists`, to two decimals."
                },
                "todayCount": {
                  "type": "integer",
                  "description": "Distinct artists whose column MCP `set` since midnight. Manual edits and UGC approvals are not counted."
                }
              }
            }
          },
          "completenessDistribution": {
            "type": "array",
            "description": "How many of the tracked columns each artist has filled, bucketed `0-1`, `2-3`, `4-6`, `7-10`, `11+`; empty buckets are absent.",
            "items": {
              "type": "object",
              "required": [
                "bucket",
                "count",
                "percentage"
              ],
              "properties": {
                "bucket": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "percentage": {
                  "type": "number"
                }
              }
            }
          },
          "medianFields": {
            "type": "number"
          },
          "averageFields": {
            "type": "number"
          },
          "enrichmentReadiness": {
            "type": "object",
            "required": [
              "hasWikidata",
              "hasSpotifyNoWikidata",
              "noSpotify"
            ],
            "properties": {
              "hasWikidata": {
                "type": "integer"
              },
              "hasSpotifyNoWikidata": {
                "type": "integer"
              },
              "noSpotify": {
                "type": "integer"
              }
            }
          }
        }
      },
      "CorrectionAbout": {
        "type": "object",
        "required": [
          "status",
          "bio",
          "revision"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "bio": {
            "type": "string",
            "description": "The published About."
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "A SHA-256 over the artist, its claim and the About. Send it back on save."
          }
        }
      }
    }
  }
}
