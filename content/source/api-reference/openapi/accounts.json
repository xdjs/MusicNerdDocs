{
  "openapi": "3.1.0",
  "info": {
    "title": "Music Nerd API: account",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://musicnerd-api.vercel.app",
      "description": "Production"
    },
    {
      "url": "https://musicnerd-api-staging.vercel.app",
      "description": "Staging (staging database)"
    }
  ],
  "paths": {
    "/api/auth/link-wallet": {
      "post": {
        "summary": "Link a wallet",
        "operationId": "linkWallet",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "Links a wallet the signed-in user owns in Privy to their Music Nerd account. If a legacy (pre-Privy) account already has that wallet, the two are merged in one transaction: the legacy account survives, takes over the Privy identity, the accepted-contribution count, the artists added, the self-edits, the activity ledger, the bookmarks and the bio corrections, and the sign-in placeholder account is deleted. A name the user confirmed in the welcome flow wins over the legacy name; an unconfirmed generated name does not. Otherwise the wallet is written to the current account.\n\nMoved from MusicNerdWeb's `POST /api/auth/link-wallet`: same body and status codes; the success body gains `status: \"ok\"` and errors use `{ status: \"error\", error }`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["walletAddress"],
                "properties": {
                  "walletAddress": {
                    "type": "string",
                    "pattern": "^0x[a-fA-F0-9]{40}$",
                    "description": "An EVM wallet address. It must be one of the wallets linked to the caller's Privy account; it is stored lower-cased."
                  }
                }
              },
              "example": {
                "walletAddress": "0x1234567890abcdef1234567890abcdef12345678"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The wallet is linked. `merged: true` means a legacy account was found and merged; `userId` is then the surviving account's id, which the client must use from now on.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkWalletResult"
                },
                "examples": {
                  "merged": {
                    "summary": "A legacy account had this wallet",
                    "value": {
                      "status": "ok",
                      "success": true,
                      "merged": true,
                      "userId": "6f1c2a3b-4d5e-4f60-8a71-82b93c4d5e6f",
                      "message": "Account merged successfully! Your contribution history has been restored."
                    }
                  },
                  "linked": {
                    "summary": "No legacy account; the wallet is saved on the current account",
                    "value": {
                      "status": "ok",
                      "success": true,
                      "merged": false,
                      "message": "Wallet linked successfully!"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The body isn't JSON (`Invalid request body`), or `walletAddress` isn't a `0x` address of 40 hex characters (`Invalid wallet address`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Invalid wallet address"
                }
              }
            }
          },
          "401": {
            "description": "No token, an invalid or expired token, no Music Nerd user for it, or a user without a Privy identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Not signed in"
                }
              }
            }
          },
          "403": {
            "description": "Privy does not list this wallet among the caller's linked accounts. A browser callback is not proof of ownership.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Wallet is not linked to your authenticated account."
                }
              }
            }
          },
          "409": {
            "description": "The legacy account with this wallet already belongs to another Privy identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "This wallet is already linked to another account"
                }
              }
            }
          },
          "500": {
            "description": "The merge was rolled back (`Merge failed`, `User not found`, `Current user has no Privy ID`, `Legacy account is already linked to another user`), or the wallet could not be saved (`Failed to link wallet`). Nothing changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Merge failed"
                }
              }
            }
          },
          "503": {
            "description": "Privy could not be reached to verify wallet ownership. Try again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Wallet verification unavailable. Please try again."
                }
              }
            }
          }
        }
      }
    },
    "/api/bookmarks": {
      "get": {
        "summary": "List bookmarks",
        "operationId": "listBookmarks",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "The signed-in user's saved artists in their saved order, with each artist's current name and image. Responses are `Cache-Control: private, no-store`.\n\nMoved from MusicNerdWeb's `GET /api/bookmarks`: same shape plus `status: \"ok\"`; errors use `{ status: \"error\", error }`.",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookmarkAccount"
          }
        ],
        "responses": {
          "200": {
            "description": "The bookmarks, first to last.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookmarks"
                },
                "example": {
                  "status": "ok",
                  "userId": "6f1c2a3b-4d5e-4f60-8a71-82b93c4d5e6f",
                  "bookmarks": [
                    {
                      "artistId": "aab92f80-f9e1-4299-aa33-7dd85c8de5d3",
                      "artistName": "Bio Ritmo",
                      "imageUrl": "https://api.deezer.com/artist/27/image?size=medium"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The request has query parameters; the account comes from the token, never the URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Unexpected query parameters"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "409": {
            "$ref": "#/components/responses/AccountChanged"
          },
          "500": {
            "description": "The bookmarks could not be read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Could not load bookmarks. Please try again."
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add bookmarks",
        "operationId": "addBookmarks",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "Saves artists to the signed-in user's bookmarks and returns the whole list. New artists go first, in the order given; artists already bookmarked keep their place, and unknown artist ids are ignored. With `import: true` (a one-time import of the browser's old list) an artist the user had removed stays removed; otherwise it comes back.\n\nMoved from MusicNerdWeb's `POST /api/bookmarks`: same body and shape plus `status: \"ok\"`; errors use `{ status: \"error\", error }`. MusicNerdWeb's same-origin check is not carried over: this API is called cross-origin with a bearer token, which a third-party site cannot send.",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookmarkAccountRequired"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["artistIds"],
                "additionalProperties": false,
                "properties": {
                  "artistIds": {
                    "$ref": "#/components/schemas/ArtistIds"
                  },
                  "import": {
                    "type": "boolean",
                    "description": "True when importing the browser's old saved list: removed artists are not resurrected."
                  }
                }
              },
              "example": {
                "artistIds": ["aab92f80-f9e1-4299-aa33-7dd85c8de5d3"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved list after the additions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookmarks"
                },
                "example": {
                  "status": "ok",
                  "userId": "6f1c2a3b-4d5e-4f60-8a71-82b93c4d5e6f",
                  "bookmarks": [
                    {
                      "artistId": "aab92f80-f9e1-4299-aa33-7dd85c8de5d3",
                      "artistName": "Bio Ritmo",
                      "imageUrl": "https://api.deezer.com/artist/27/image?size=medium"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidBookmarkRequest"
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "409": {
            "$ref": "#/components/responses/AccountChanged"
          },
          "500": {
            "$ref": "#/components/responses/CouldNotSave"
          }
        }
      },
      "patch": {
        "summary": "Reorder and remove bookmarks",
        "operationId": "editBookmarks",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "Applies a saved-order draft: removes `removedArtistIds`, then orders the rest as `orderedArtistIds`. A stale draft cannot undo newer changes: artists bookmarked since the draft was taken stay, ahead of the draft's order, and artists removed since stay removed. Returns the whole list.\n\nMoved from MusicNerdWeb's `PATCH /api/bookmarks`: same body and shape plus `status: \"ok\"`; errors use `{ status: \"error\", error }`. MusicNerdWeb's same-origin check is not carried over (bearer token, cross-origin by design).",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookmarkAccountRequired"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["orderedArtistIds", "removedArtistIds"],
                "additionalProperties": false,
                "properties": {
                  "orderedArtistIds": {
                    "$ref": "#/components/schemas/ArtistIds"
                  },
                  "removedArtistIds": {
                    "$ref": "#/components/schemas/ArtistIds"
                  }
                }
              },
              "example": {
                "orderedArtistIds": ["aab92f80-f9e1-4299-aa33-7dd85c8de5d3"],
                "removedArtistIds": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved list after the edit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookmarks"
                },
                "example": {
                  "status": "ok",
                  "userId": "6f1c2a3b-4d5e-4f60-8a71-82b93c4d5e6f",
                  "bookmarks": [
                    {
                      "artistId": "aab92f80-f9e1-4299-aa33-7dd85c8de5d3",
                      "artistName": "Bio Ritmo",
                      "imageUrl": "https://api.deezer.com/artist/27/image?size=medium"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidBookmarkRequest"
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "409": {
            "$ref": "#/components/responses/AccountChanged"
          },
          "500": {
            "$ref": "#/components/responses/CouldNotSave"
          }
        }
      },
      "delete": {
        "summary": "Remove a bookmark",
        "operationId": "removeBookmark",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "Removes one artist from the signed-in user's bookmarks and returns the whole list. Removing an artist that isn't bookmarked changes nothing.\n\nMoved from MusicNerdWeb's `DELETE /api/bookmarks`: same body and shape plus `status: \"ok\"`; errors use `{ status: \"error\", error }`. MusicNerdWeb's same-origin check is not carried over (bearer token, cross-origin by design).",
        "parameters": [
          {
            "$ref": "#/components/parameters/BookmarkAccountRequired"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["artistId"],
                "additionalProperties": false,
                "properties": {
                  "artistId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              },
              "example": {
                "artistId": "aab92f80-f9e1-4299-aa33-7dd85c8de5d3"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved list after the removal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookmarks"
                },
                "example": {
                  "status": "ok",
                  "userId": "6f1c2a3b-4d5e-4f60-8a71-82b93c4d5e6f",
                  "bookmarks": []
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidBookmarkRequest"
          },
          "401": {
            "$ref": "#/components/responses/NotSignedIn"
          },
          "409": {
            "$ref": "#/components/responses/AccountChanged"
          },
          "500": {
            "$ref": "#/components/responses/CouldNotSave"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "privyBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Access token",
        "description": "The signed-in user's access token. Copy it at https://musicnerd.net/access after signing in. Any Music Nerd user; the account is the token's, never the request's."
      }
    },
    "parameters": {
      "BookmarkAccount": {
        "name": "X-Bookmark-Account",
        "in": "header",
        "required": false,
        "description": "The account id the client believes it is signed in as. When sent, it must equal the token's user id or the request is refused with 409, so a page left open across a sign-out and sign-in cannot read or write another account's list.",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "6f1c2a3b-4d5e-4f60-8a71-82b93c4d5e6f"
      },
      "BookmarkAccountRequired": {
        "name": "X-Bookmark-Account",
        "in": "header",
        "required": true,
        "description": "The account id the client believes it is signed in as. Required on every write and it must equal the token's user id, or the request is refused with 409: a page left open across a sign-out and sign-in cannot write another account's list.",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "6f1c2a3b-4d5e-4f60-8a71-82b93c4d5e6f"
      }
    },
    "responses": {
      "NotSignedIn": {
        "description": "No token, an invalid or expired token, or no Music Nerd user for it.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "error": "Not signed in"
            }
          }
        }
      },
      "AccountChanged": {
        "description": "`X-Bookmark-Account` is missing on a write, or names a different account than the token. Reload and try again.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "error": "Account changed. Refresh before updating bookmarks."
            }
          }
        }
      },
      "InvalidBookmarkRequest": {
        "description": "The body isn't JSON (`Invalid JSON body`); the body has unknown fields, an id that isn't a UUID or more than 500 ids (`Invalid bookmark request`); or the request has query parameters (`Unexpected query parameters`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "error": "Invalid bookmark request"
            }
          }
        }
      },
      "CouldNotSave": {
        "description": "The write was rolled back; nothing changed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "status": "error",
              "error": "Could not save bookmarks. Please try again."
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["status", "error"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["error"]
          },
          "error": {
            "type": "string"
          }
        }
      },
      "ArtistIds": {
        "type": "array",
        "maxItems": 500,
        "description": "Artist ids (UUIDs, any case; stored lower-cased). Duplicates are collapsed.",
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Bookmark": {
        "type": "object",
        "required": ["artistId", "artistName", "imageUrl"],
        "properties": {
          "artistId": {
            "type": "string",
            "format": "uuid"
          },
          "artistName": {
            "type": "string",
            "description": "The artist's current name; `Unknown Artist` when the row has none."
          },
          "imageUrl": {
            "type": ["string", "null"],
            "description": "The artist's uploaded image when it is a site-relative path or an `https:` URL without credentials, else their Deezer image when a numeric Deezer id is known, else `null`."
          }
        }
      },
      "Bookmarks": {
        "type": "object",
        "required": ["status", "userId", "bookmarks"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "The account the list belongs to: the token's user."
          },
          "bookmarks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Bookmark"
            }
          }
        }
      },
      "LinkWalletResult": {
        "type": "object",
        "required": ["status", "success", "merged", "message"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "success": {
            "type": "boolean",
            "enum": [true]
          },
          "merged": {
            "type": "boolean",
            "description": "True when a legacy account with this wallet was merged into."
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Only when `merged` is true: the surviving (legacy) account's id. The caller's token now maps to this account."
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
