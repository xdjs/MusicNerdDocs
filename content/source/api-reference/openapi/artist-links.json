{
  "openapi": "3.1.0",
  "info": {
    "title": "Music Nerd API: artist links",
    "version": "1.0.0",
    "description": "Writing, ordering, checking and reviewing the platform links on an artist's profile."
  },
  "servers": [
    {
      "url": "https://musicnerd-api.vercel.app",
      "description": "Production"
    },
    {
      "url": "https://musicnerd-api-staging.vercel.app",
      "description": "Staging (staging database)"
    }
  ],
  "paths": {
    "/api/artist/link-order": {
      "put": {
        "summary": "Save the artist's link order",
        "operationId": "putArtistLinkOrder",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "Saves the order of the artist's `links` or `support` section, for the claimant or an admin. Every name must be `spotify`, `deezer` or a supported platform; the next profile render uses the order.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "artistId",
                  "section",
                  "order"
                ],
                "properties": {
                  "artistId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "section": {
                    "type": "string",
                    "enum": [
                      "links",
                      "support"
                    ],
                    "description": "Which link group was reordered."
                  },
                  "order": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "description": "Platform names (urlmap `siteName`s) in display order, no duplicates."
                  }
                }
              },
              "example": {
                "artistId": "6cb3d81a-3d02-4c57-a711-bb7902a9af1b",
                "section": "links",
                "order": [
                  "spotify",
                  "instagram",
                  "youtube"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                },
                "example": {
                  "status": "ok",
                  "success": true
                }
              }
            }
          },
          "400": {
            "description": "The body is not a valid link order (`Invalid link order`), or a name is not a known platform (`Unknown platform`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Invalid link order"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Not signed in"
                }
              }
            }
          },
          "403": {
            "description": "The user is not the artist's approved claimant or an admin (`Not authorized for this artist`), or the claim changed while saving (`Artist ownership changed; this operation was cancelled.`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Not authorized for this artist"
                }
              }
            }
          },
          "404": {
            "description": "No artist has that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Artist not found"
                }
              }
            }
          },
          "500": {
            "description": "The order could not be saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Could not save link order"
                }
              }
            }
          }
        }
      }
    },
    "/api/directEditLink": {
      "post": {
        "summary": "Set or clear an artist link",
        "operationId": "postDirectEditLink",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "Writes one platform link straight onto the artist, for the approved claimant or an admin, and returns the platform written. `set` reads the platform and ID from `url`: song and album URLs are refused, and an Apple Music or Beatport artist page is saved as an approved Lore source instead (`siteName` is then `applemusic` or `beatport`). `clear` empties the platform's link.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "artistId",
                  "action"
                ],
                "properties": {
                  "artistId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "set",
                      "clear"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "description": "The profile URL to save. Required for `set`."
                  },
                  "siteName": {
                    "type": "string",
                    "description": "The platform column to empty. Required for `clear`."
                  }
                }
              },
              "examples": {
                "set": {
                  "value": {
                    "artistId": "6cb3d81a-3d02-4c57-a711-bb7902a9af1b",
                    "action": "set",
                    "url": "https://www.instagram.com/p3t3rango/"
                  }
                },
                "clear": {
                  "value": {
                    "artistId": "6cb3d81a-3d02-4c57-a711-bb7902a9af1b",
                    "action": "clear",
                    "siteName": "instagram"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Written. `siteName` and `platformName` come back for `set`; `platformName` is the urlmap display name and may be null.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "success"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "siteName": {
                      "type": "string",
                      "description": "The column written, or `applemusic` / `beatport` for a source-backed link."
                    },
                    "platformName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "success": true,
                  "siteName": "instagram",
                  "platformName": "Instagram"
                }
              }
            }
          },
          "400": {
            "description": "Missing or wrong input: `artistId and action are required`, `artistId must be a UUID`, `action must be 'set' or 'clear'`, `url is required for set action`, `siteName is required for clear action`, `Add an artist profile link, not a song or album.`, or the platform is not supported (`We don't support that link yet — we currently accept links from a fixed set of platforms. Check the \"Supported links\" list to see them.`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "url is required for set action"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Not signed in"
                }
              }
            }
          },
          "403": {
            "description": "The user is not the artist's approved claimant or an admin (`Not authorized for this artist`), or the claim changed while writing (`Artist ownership changed; this operation was cancelled.`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Not authorized for this artist"
                }
              }
            }
          },
          "409": {
            "description": "The id belongs to another artist (`That spotify artist ID is already linked to a different artist`, `That spotify artist ID conflicts with an existing artist mapping`; same for `deezer`), or the Apple Music / Beatport page is already in Lore (`This link has already been suggested. Review it in Lore.`) or another account is already connected on that platform (`A different account is already connected. Remove the existing link before approving this replacement.`). `code` is always `CONFLICT`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConflictError"
                },
                "example": {
                  "status": "error",
                  "error": "That spotify artist ID is already linked to a different artist",
                  "code": "CONFLICT"
                }
              }
            }
          },
          "500": {
            "description": "The write failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/api/removeArtistData": {
      "post": {
        "summary": "Remove an artist link",
        "operationId": "postRemoveArtistData",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "Empties one platform link on an artist, for any whitelisted user or admin, not only the claimant. The contributor's original submission is kept so their credit stands. For `wallets`, only the artist's own ID is removed from the list.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "artistId",
                  "siteName"
                ],
                "properties": {
                  "artistId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "siteName": {
                    "type": "string",
                    "description": "The platform column to empty."
                  }
                }
              },
              "example": {
                "artistId": "6cb3d81a-3d02-4c57-a711-bb7902a9af1b",
                "siteName": "instagram"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Removed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "success",
                    "message"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "success": true,
                  "message": "Artist data removed"
                }
              }
            }
          },
          "400": {
            "description": "The body is not JSON (`Invalid request body`) or a field is missing (`artistId and siteName are required`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "artistId and siteName are required"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Not signed in"
                }
              }
            }
          },
          "403": {
            "description": "The user is neither whitelisted nor an admin (`Unauthorized`), the column is not a writable link (`Invalid platform column`), or the write failed (`Error removing artist data`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Unauthorized"
                }
              }
            }
          },
          "500": {
            "description": "The user could not be read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/api/validateLink": {
      "post": {
        "summary": "Check a profile link is live",
        "operationId": "postValidateLink",
        "security": [],
        "description": "Fetches a YouTube, SoundCloud, Bandcamp, Audius, Last.fm, OpenSea, Zora, Catalog, Supercollector or Mintsongs profile URL and says whether the page exists. A missing page, or a network failure, gives `valid: false` with a `reason`. No credentials.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "url": "https://soundcloud.com/peterango"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checked. `reason` is present only when `valid` is false: `404 Not Found`, `soundcloud 404 redirect`, `<platform> error page` or `Network error or invalid URL`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "valid"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "valid": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "valid": false,
                  "reason": "soundcloud error page"
                }
              }
            }
          },
          "400": {
            "description": "`url` is missing, not a string, or the body is not JSON (`No URL provided`), or no supported platform reads it (`Unsupported platform or invalid URL`). `valid` and `reason` are returned beside the error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "error",
                    "valid",
                    "reason"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ]
                    },
                    "error": {
                      "type": "string"
                    },
                    "valid": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "status": "error",
                  "error": "Unsupported platform or invalid URL",
                  "valid": false,
                  "reason": "Unsupported platform or invalid URL"
                }
              }
            }
          }
        }
      }
    },
    "/api/platformRegexes": {
      "get": {
        "summary": "List platform URL patterns",
        "operationId": "getPlatformRegexes",
        "security": [],
        "description": "Every supported platform's URL pattern except `ens` and `wallets`, so a client can recognise a link before submitting it. Catalog, Foundation and sound.xyz are left out, as everywhere in this API. No credentials.",
        "responses": {
          "200": {
            "description": "The patterns.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "regexes"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "regexes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "siteName",
                          "regex"
                        ],
                        "properties": {
                          "siteName": {
                            "type": "string"
                          },
                          "regex": {
                            "type": "string",
                            "description": "A JavaScript regular expression source."
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "regexes": [
                    {
                      "siteName": "instagram",
                      "regex": "^https?://(www\\.)?instagram\\.com/([^/?#]+)"
                    },
                    {
                      "siteName": "soundcloud",
                      "regex": "^https://(www\\.)?soundcloud\\.com/([^/]+)(?:/.*)?$"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "The table could not be read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Could not load platform patterns"
                }
              }
            }
          }
        }
      }
    },
    "/api/artist/{id}/link-suggestions": {
      "get": {
        "summary": "List link suggestions",
        "operationId": "getArtistLinkSuggestions",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "The links contributors and research have proposed for the artist, pending first then newest, 100 per page, for the approved claimant or an admin. Song and album URLs are left out. Who suggested or reviewed each one is a display name only: `Automated research` for research, `Not recorded` when hidden or unknown.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The artist's id (a UUID).",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "6cb3d81a-3d02-4c57-a711-bb7902a9af1b"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Where the page starts; 0 to 100000.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "items",
                    "hasMore",
                    "nextOffset"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LinkSuggestion"
                      }
                    },
                    "hasMore": {
                      "type": "boolean"
                    },
                    "nextOffset": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "description": "The `offset` for the next page, or null on the last one."
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "items": [
                    {
                      "id": "0f3a7c62-1d7e-4b1e-9a7a-5b1f0c0e2a11",
                      "kind": "ugc",
                      "url": "https://www.instagram.com/p3t3rango/",
                      "title": "instagram",
                      "platform": "instagram",
                      "hidden": false,
                      "status": "pending",
                      "origin": "submission",
                      "submittedAt": "2026-10-20T18:02:11.000Z",
                      "suggestedBy": {
                        "id": "4d1a2b3c-0000-4000-8000-000000000042",
                        "name": "musicnerd_fan"
                      },
                      "reviewedAt": null,
                      "reviewedBy": null
                    }
                  ],
                  "hasMore": false,
                  "nextOffset": null
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "`private, no-store`: the list is the caller's, never shared or cached.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "`id` is not a UUID (`Invalid artist ID`) or `offset` is not an integer in range (`Invalid page offset`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Invalid page offset"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Not signed in"
                }
              }
            }
          },
          "403": {
            "description": "The user is not the artist's approved claimant or an admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Not authorized for this artist"
                }
              }
            }
          },
          "500": {
            "description": "The list could not be loaded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Could not load link suggestions"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Review a link suggestion",
        "operationId": "postArtistLinkSuggestionReview",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "Approves, dismisses, removes or restores one suggestion, as the approved claimant or an admin. Approving a link writes it to the profile (an Apple Music or Beatport page becomes an approved Lore source), and approving a source also queues its text extraction; `remove` hides an approved source's icon and `restore` shows it again, both keeping it in Lore. Every decision is recorded in the artist's activity.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The artist's id (a UUID).",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "6cb3d81a-3d02-4c57-a711-bb7902a9af1b"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "decision"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "The suggestion's id, from the list."
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "ugc",
                      "source"
                    ]
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approve",
                      "dismiss",
                      "remove",
                      "restore"
                    ],
                    "description": "`remove` and `restore` apply only to an approved source."
                  }
                }
              },
              "example": {
                "id": "0f3a7c62-1d7e-4b1e-9a7a-5b1f0c0e2a11",
                "kind": "ugc",
                "decision": "approve"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reviewed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success"
                },
                "example": {
                  "status": "ok",
                  "success": true
                }
              }
            }
          },
          "400": {
            "description": "`id` is not a UUID or the body is not a valid decision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Invalid review request"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Not signed in"
                }
              }
            }
          },
          "403": {
            "description": "The user is not the artist's approved claimant or an admin, or the claim changed during the review.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Not authorized for this artist"
                }
              }
            }
          },
          "409": {
            "description": "The suggestion cannot be reviewed as asked: it is gone (`This suggestion is no longer available. Refresh the profile.`), already reviewed (`This suggestion has already been reviewed. Refresh the profile.`), not a profile link (`This is not an artist profile link. Review it in Lore.`), only approved sources can be removed or restored, the URL already exists in Lore (`This URL already exists in Lore. Review that source instead.`), or a different account is already connected on that platform (`A different account is already connected. Remove the existing link before approving this replacement.`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "This suggestion has already been reviewed. Refresh the profile."
                }
              }
            }
          },
          "500": {
            "description": "The review could not be saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Could not review this link"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "privyBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Access token",
        "description": "The signed-in user's access token. Copy it at https://musicnerd.net/access after signing in. Link writes need the artist's approved claimant or a Music Nerd admin; `removeArtistData` accepts any whitelisted user too."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "string"
          }
        }
      },
      "ConflictError": {
        "type": "object",
        "required": [
          "status",
          "error",
          "code"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "CONFLICT"
            ]
          }
        }
      },
      "Success": {
        "type": "object",
        "required": [
          "status",
          "success"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "LinkSuggestion": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "url",
          "title",
          "platform",
          "hidden",
          "status",
          "origin",
          "submittedAt",
          "suggestedBy",
          "reviewedAt",
          "reviewedBy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ugc",
              "source"
            ],
            "description": "A contributor's UGC submission, or a Lore source."
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "The platform name for UGC; the source's title, else the destination's label, else `Website`."
          },
          "platform": {
            "type": "string",
            "description": "The platform column for UGC; the destination's platform for a source, else `website`."
          },
          "hidden": {
            "type": "boolean",
            "description": "True when an approved source's icon was removed from the profile."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "origin": {
            "type": "string",
            "description": "`submission`, `research`, `upload` or `unknown`."
          },
          "submittedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "suggestedBy": {
            "$ref": "#/components/schemas/Person"
          },
          "reviewedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "reviewedBy": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Person"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "description": "A display name only; no email or wallet. `id` is null and `name` is `Not recorded` when the account is hidden or unknown; research shows as `Automated research`.",
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
