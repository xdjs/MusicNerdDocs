    "/api/artist/{id}/research/evidence/{evidenceId}": {
      "get": {
        "summary": "Read a public research original",
        "description": "Returns the exact text of one public source that research read. Pass a reference's URL-encoded `sourceId` or an evidence ID; a 409 means the source has changed since. Private and uploaded material is never returned.",
        "security": [
          {
            "PrivyAuth": []
          },
          {
            "ResearchService": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "evidenceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "URL-encoded sourceId from a returned reference, or a discovery evidence UUID"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          {
            "name": "start",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "maximum": 4000000
            }
          },
          {
            "name": "maxChars",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 256,
              "maximum": 12000,
              "default": 4000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "passage",
                    "totalChars",
                    "nextStart"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "passage": {
                      "$ref": "#/components/schemas/Reference"
                    },
                    "totalChars": {
                      "type": "integer"
                    },
                    "nextStart": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
