  "components": {
    "securitySchemes": {
      "PrivyAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Current artist claimant or administrator Privy access token."
      },
      "ResearchService": {
        "type": "apiKey",
        "in": "header",
        "name": "X-MusicNerd-Research-Key",
        "description": "Server-only MUSICNERD_RESEARCH_API_KEY. Public evidence research only; never grants review or interview-history access."
      }
    },
    "schemas": {
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "evidenceNeed"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "description": "Neutral public work/topic terms, not private visitor chat."
          },
          "evidenceNeed": {
            "type": "string",
            "enum": [
              "reporting",
              "release_date",
              "credits",
              "social_caption",
              "spoken_content"
            ]
          },
          "freshness": {
            "type": "string",
            "enum": [
              "stored",
              "recent"
            ],
            "default": "stored",
            "description": "With `relevance` retrieval, `recent` means the past seven days unless `fromDate` is set. With `latest` retrieval, the newest evidence may be older."
          },
          "targetUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "platform": {
            "type": "string",
            "enum": [
              "instagram",
              "tiktok",
              "x",
              "inprocess",
              "spotify",
              "deezer"
            ],
            "description": "Restrict evidence to this platform. If that platform's saved sources can't answer, or it conflicts with `targetUrl`, the job ends unresolved."
          },
          "fromDate": {
            "type": "string",
            "format": "date"
          },
          "toDate": {
            "type": "string",
            "format": "date"
          },
          "retrieval": {
            "type": "string",
            "enum": [
              "relevance",
              "latest"
            ],
            "default": "relevance",
            "description": "`latest` for the newest activity or the newest post on a platform; `relevance` for a specific topic or fact. `fromDate` and `toDate` apply to both."
          },
          "excludeSourceUrls": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "maxLength": 2000,
              "pattern": "^https?://"
            },
            "description": "Exact public citation URLs already discussed; excluded before evidence selection and included in request identity."
          },
          "answerScope": {
            "type": "string",
            "enum": [
              "focused",
              "overview"
            ],
            "default": "focused",
            "description": "`overview` for a broad account of recent activity, `focused` for one post, release or detail."
          },
          "preferDirectEvidence": {
            "type": "boolean",
            "description": "Service credential only. Offer saved candidates for an answer attempt before ordinary research. Defaults to false."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "status",
          "error",
          "code"
        ],
        "properties": {
          "status": {
            "const": "error"
          },
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "quotaScope": {
            "type": "string",
            "enum": [
              "saved_global",
              "outside_artist",
              "outside_global"
            ],
            "description": "Shared operational budget that blocked this work, never a personal visitor limit."
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Seconds until resetAt, rounded up. A current status read recomputes this duration; new traffic can consume later capacity."
          },
          "resetAt": {
            "type": "string",
            "format": "date-time",
            "description": "Actual rolling-window boundary calculated when the quota was checked."
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "status",
          "jobId",
          "stage",
          "message",
          "updatedAt",
          "references",
          "limitations"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "stage": {
            "type": "string",
            "enum": [
              "checking_saved",
              "searching",
              "reading",
              "transcribing",
              "waiting_provider",
              "complete",
              "unresolved",
              "failed",
              "cancelled"
            ]
          },
          "message": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reused": {
            "type": "boolean"
          },
          "references": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "$ref": "#/components/schemas/Reference"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outsideResearchReason": {
            "type": "string",
            "enum": [
              "quota"
            ],
            "description": "Why research didn't look beyond saved sources. Saved sources may still answer; a quota block includes when to ask again."
          },
          "selection": {
            "type": "string",
            "enum": [
              "candidates",
              "research"
            ],
            "description": "`candidates`: saved evidence offered for an answer attempt, not yet an answer; continue this job if it isn't enough. `research`: the ordinary research path."
          },
          "quotaScope": {
            "type": "string",
            "enum": [
              "saved_global",
              "outside_artist",
              "outside_global"
            ],
            "description": "Shared operational budget that blocked this work, never a personal visitor limit."
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Seconds until resetAt, rounded up. A current status read recomputes this duration; new traffic can consume later capacity."
          },
          "resetAt": {
            "type": "string",
            "format": "date-time",
            "description": "Actual rolling-window boundary calculated when the quota was checked."
          }
        }
      },
      "Reference": {
        "type": "object",
        "required": [
          "sourceId",
          "revision",
          "start",
          "end",
          "text",
          "url",
          "curation"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "description": "Stable reference to the source. It stops working if the source is removed or its account is disconnected; a changed source gets a new revision."
          },
          "revision": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "curation": {
            "type": "string",
            "enum": [
              "approved",
              "pending"
            ]
          },
          "evidenceKind": {
            "type": "string",
            "enum": [
              "original_text",
              "caption",
              "provider_transcript"
            ]
          },
          "speaker": {
            "type": "string",
            "enum": [
              "not_applicable",
              "unverified"
            ]
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrievedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "truncated": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "activityDate": {
            "type": "string",
            "description": "Optional provider activity date. Preserves YYYY, YYYY-MM or full date/time precision. Never substitutes for source publication time."
          },
          "activityDateKind": {
            "type": "string",
            "enum": [
              "release",
              "moment"
            ],
            "description": "Meaning of activityDate. Exact catalog release-date claims require original catalog text, not publishedAt."
          }
        }
      },
      "Review": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "decision"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "decline",
              "wrong_artist",
              "incorrect"
            ]
          }
        }
      },
      "Candidate": {
        "type": "object",
        "required": [
          "id",
          "url",
          "destination",
          "identity",
          "curation",
          "reason",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "destination": {
            "enum": [
              "lore",
              "link"
            ]
          },
          "identity": {
            "enum": [
              "confirmed",
              "unresolved",
              "wrong_artist"
            ]
          },
          "curation": {
            "enum": [
              "pending",
              "approved",
              "declined",
              "wrong_artist",
              "incorrect"
            ]
          },
          "reason": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
