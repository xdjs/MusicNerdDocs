{
  "openapi": "3.1.0",
  "info": {
    "title": "Music Nerd API: onboarding",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://musicnerd-api.vercel.app",
      "description": "Production"
    },
    {
      "url": "https://musicnerd-api-staging.vercel.app",
      "description": "Staging (staging database)"
    }
  ],
  "paths": {
    "/api/onboarding/{artistId}/chat": {
      "post": {
        "summary": "Onboarding chat turn",
        "operationId": "postOnboardingChatTurn",
        "security": [
          {
            "privyBearer": []
          }
        ],
        "description": "One turn of an artist's onboarding, streamed as server-sent events. The server owns the step order (profiles \u2192 vault \u2192 interview \u2192 publish): a turn for a step that is not current gets an `error` event and the real step. Confirmed steps are resumed rather than repeated. A fresh claim's opening turn builds the whole page without asking anything; the artist corrects it on the page afterwards. A turn stops at 55 seconds and says so, and the server finishes the work even if the client disconnects.\n\nEach event is a `data:` line holding one JSON object with a `kind`: `chat`, `progress`, `step`, `candidate`, `linked`, `unreachable`, `source`, `sources`, `text-delta`, `choices`, `draft`, `complete` or `error`. A turn ends with `step`, `draft`, `complete` or `error`.\n\nThe initial interview prepares up to three questions once from already saved material, with one 15-second total preparation budget. It does not wait for a social scrape. Drafting and source verification share that deadline; timed-out model work is cancelled and only verified questions may be used. Remaining slots use distinct optional general questions. The private question plan is reused after answers, skips, reloads and server restarts, scoped to the current claim. Choosing a fallback plan does not retry generation on each skip. Prepared questions are not artist testimony; only explicit answers/skips create answer records. Saved history is checked before offering the next question; a history read failure returns a recoverable error rather than restarting or completing the interview. Each answered/skipped key counts once toward the three-question cap. Existing answer revisions and explicit publication are unchanged.",
        "parameters": [
          {
            "name": "artistId",
            "in": "path",
            "required": true,
            "description": "The artist's ID (a UUID). Staging and production IDs differ.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "aab92f80-f9e1-4299-aa33-7dd85c8de5d3"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "title": "open",
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "open"
                      }
                    },
                    "description": "Start or resume. On a fresh claim this runs the whole auto-build: find profiles, search for sources and approve the ones it read, write the Lore and the About, and confirm every step. Anywhere else it resumes at the current step with that step's card, reusing saved discovery rather than searching again."
                  },
                  {
                    "type": "object",
                    "title": "confirm_profiles",
                    "required": [
                      "type",
                      "addedLinks",
                      "removedSiteNames"
                    ],
                    "properties": {
                      "type": {
                        "const": "confirm_profiles"
                      },
                      "addedLinks": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "object",
                          "required": [
                            "url"
                          ],
                          "properties": {
                            "url": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "removedSiteNames": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "description": "Confirm the profiles step, adding and removing links."
                  },
                  {
                    "type": "object",
                    "title": "find_more_profiles",
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "find_more_profiles"
                      },
                      "addedLinks": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "object",
                          "required": [
                            "url"
                          ],
                          "properties": {
                            "url": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "removedSiteNames": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "description": "Apply link changes and search again, without confirming the step."
                  },
                  {
                    "type": "object",
                    "title": "vault_review",
                    "required": [
                      "type",
                      "decisions",
                      "addedUrls"
                    ],
                    "properties": {
                      "type": {
                        "const": "vault_review"
                      },
                      "decisions": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "object",
                          "required": [
                            "sourceId",
                            "status"
                          ],
                          "properties": {
                            "sourceId": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "approved",
                                "rejected"
                              ]
                            }
                          }
                        }
                      },
                      "addedUrls": {
                        "type": "array",
                        "maxItems": 100,
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "description": "Approve or reject the displayed sources and add URLs, when onboarding resumes at the sources step; confirms it. All pending sources must be reviewed before moving on. Previously rejected sources stay rejected. Generated text can reuse a private prepared draft only when every cited original is unchanged and approved and no newer artist material would be omitted."
                  },
                  {
                    "type": "object",
                    "title": "interview_answer",
                    "required": [
                      "type",
                      "questionKey",
                      "answer"
                    ],
                    "properties": {
                      "type": {
                        "const": "interview_answer"
                      },
                      "questionKey": {
                        "type": "string"
                      },
                      "answer": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "`null` skips the question."
                      },
                      "question": {
                        "type": "string",
                        "description": "The question text, for grounded (`social_\u2026`) questions."
                      }
                    },
                    "description": "Answer or skip one interview question."
                  },
                  {
                    "type": "object",
                    "title": "about_choice",
                    "required": [
                      "type",
                      "mode",
                      "doc"
                    ],
                    "properties": {
                      "type": {
                        "const": "about_choice"
                      },
                      "mode": {
                        "type": "string",
                        "enum": [
                          "generate",
                          "self"
                        ]
                      },
                      "doc": {
                        "type": "string"
                      },
                      "sources": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    },
                    "description": "Generate the About from the doc, or write it yourself."
                  },
                  {
                    "type": "object",
                    "title": "publish",
                    "required": [
                      "type",
                      "doc",
                      "about",
                      "expectedBio"
                    ],
                    "properties": {
                      "type": {
                        "const": "publish"
                      },
                      "doc": {
                        "type": "string"
                      },
                      "about": {
                        "type": "string"
                      },
                      "sources": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      },
                      "expectedBio": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "The bio the draft started from; a different current bio is refused."
                      }
                    },
                    "description": "Publish the About and save the doc; confirms the publish step."
                  }
                ]
              },
              "example": {
                "type": "open"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A stream of turn events.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "data: {\"kind\":\"chat\",\"text\":\"Your profile is yours. Building your page now, which takes a moment.\"}\n\ndata: {\"kind\":\"progress\",\"label\":\"Finding your profiles\",\"done\":false,\"group\":\"platform-search\"}\n\ndata: {\"kind\":\"complete\"}\n\n"
              }
            }
          },
          "400": {
            "description": "The artist ID is not a UUID, the body is not JSON or not a known turn, or an array has more than 100 items.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Invalid turn"
                }
              }
            }
          },
          "401": {
            "description": "No token, an invalid or expired token, or no Music Nerd user for it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Not signed in"
                }
              }
            }
          },
          "403": {
            "description": "The user is neither the artist's claimant nor an admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Not your artist"
                }
              }
            }
          }
        }
      }
    },
    "/api/onboarding/{artistId}/state": {
      "get": {
        "summary": "Onboarding state",
        "operationId": "getOnboardingState",
        "security": [],
        "description": "Where onboarding stands: confirmed steps and their confirmation times. The profile can poll this while onboarding is open. Public, uncached, and limited to step names and timestamps; it does not expose pending sources or private prepared text.\n\nAdding an artist discovers public links and Latest material while About and Lore remain private. A fresh open builds the page, confirming `profiles` (Links), `vault` (Lore) and then `interview` and `publish` together (About). On a resume, interview answers are optional and individually answered or skipped, and About is public after the publish turn. There is no fixed completion time. An artist with no onboarding, or an unknown ID, returns every step null and currentStep profiles.",
        "parameters": [
          {
            "name": "artistId",
            "in": "path",
            "required": true,
            "description": "The artist's ID (a UUID). Staging and production IDs differ.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "aab92f80-f9e1-4299-aa33-7dd85c8de5d3"
          }
        ],
        "responses": {
          "200": {
            "description": "The artist's onboarding state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingState"
                },
                "examples": {
                  "complete": {
                    "summary": "Built (Bio Ritmo on staging)",
                    "value": {
                      "status": "ok",
                      "complete": true,
                      "currentStep": null,
                      "steps": {
                        "profiles": "2026-10-02T23:33:42.122Z",
                        "vault": "2026-10-02T23:33:46.437Z",
                        "interview": "2026-10-02T23:33:58.667Z",
                        "publish": "2026-10-02T23:33:58.667Z"
                      }
                    }
                  },
                  "building": {
                    "summary": "Mid-build: profiles and sources done, writing the About",
                    "value": {
                      "status": "ok",
                      "complete": false,
                      "currentStep": "interview",
                      "steps": {
                        "profiles": "2026-10-02T23:33:42.122Z",
                        "vault": "2026-10-02T23:33:46.437Z",
                        "interview": null,
                        "publish": null
                      }
                    }
                  },
                  "notStarted": {
                    "summary": "Not started",
                    "value": {
                      "status": "ok",
                      "complete": false,
                      "currentStep": "profiles",
                      "steps": {
                        "profiles": null,
                        "vault": null,
                        "interview": null,
                        "publish": null
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`artistId` isn't a UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Invalid artist id"
                }
              }
            }
          },
          "503": {
            "description": "The state couldn't be read. Retry; don't treat it as \"not started\".",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "status": "error",
                  "error": "Onboarding state unavailable"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "privyBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Access token",
        "description": "The signed-in user's access token. Copy it at https://musicnerd.net/access after signing in. The user must be the artist's approved claimant or a Music Nerd admin."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "string"
          }
        }
      },
      "OnboardingState": {
        "type": "object",
        "required": [
          "status",
          "complete",
          "currentStep",
          "steps"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "complete": {
            "type": "boolean",
            "description": "True once `publish` is confirmed: the profile is built. The page stops polling here."
          },
          "currentStep": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "profiles",
              "vault",
              "interview",
              "publish",
              null
            ],
            "description": "The first step, in order, without a confirmation. `null` once all four are confirmed. `profiles` for an artist that hasn't started."
          },
          "steps": {
            "type": "object",
            "required": [
              "profiles",
              "vault",
              "interview",
              "publish"
            ],
            "description": "When each step was confirmed (ISO 8601, UTC), or `null` if it hasn't been.",
            "properties": {
              "profiles": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Profiles found and linked. The Links section can show them."
              },
              "vault": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Sources saved. The Lore section can show them."
              },
              "interview": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "The interview step. The auto-build confirms it together with `publish`; on a resume, after the optional questions are answered or skipped."
              },
              "publish": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "The Lore and About written. The About can show."
              }
            }
          }
        }
      }
    }
  }
}
